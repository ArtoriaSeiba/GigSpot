<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gig Management Hub</title>
    <link rel="stylesheet" href="styles.css?v=4">
</head>
<body>

    <div id="login-view" class="auth-view">
        <div class="auth-card">
            <div class="logo-container" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18V5l12-2v13"></path>
                    <circle cx="6" cy="18" r="3"></circle>
                    <circle cx="18" cy="16" r="3"></circle>
                </svg>
                <h1 style="color: var(--accent); letter-spacing: 2px; margin: 0;">GigSpot</h1>
            </div>
            <p style="color: var(--text-secondary); margin-bottom: 2rem;">Band Management & Scheduling</p>
            <form onsubmit="handleLogin(event)">
                <div class="form-group" style="text-align: left;">
                    <label>Email Address</label>
                    <input type="email" class="form-control" value="ipan@packetloss.com" pattern=".*@.*" title="Please include an '@' in the email address." required>
                </div>
                <div class="form-group" style="text-align: left;">
                    <label>Password</label>
                    <input type="password" class="form-control" value="password123" required>
                </div>
                <div style="text-align: right; margin-bottom: 1rem;">
                    <span class="auth-link" style="font-size: 0.85rem;" onclick="toggleAuthView('forgot')">Forgot Password?</span>
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">Sign In</button>
            </form>
            <p style="margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-secondary);">
                Don't have an account? <span class="auth-link" onclick="toggleAuthView('signup')">Sign Up</span>
            </p>
            <div style="margin: 1.5rem 0; color: var(--text-secondary);">OR</div>
            <button class="btn google-btn" onclick="handleLogin(event)">
                <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/></svg>
                Sign in with Google
            </button>
        </div>
    </div>

    <div id="signup-view" class="auth-view hidden">
        <div class="auth-card">
            <div class="logo-container" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18V5l12-2v13"></path>
                    <circle cx="6" cy="18" r="3"></circle>
                    <circle cx="18" cy="16" r="3"></circle>
                </svg>
                <h1 style="color: var(--accent); letter-spacing: 2px; margin: 0;">GigSpot</h1>
            </div>
            <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Create a Band Admin Account</p>
            <form onsubmit="handleSignup(event)">
                <div class="form-group" style="text-align: left;">
                    <label>Full Name</label>
                    <input type="text" id="signupName" class="form-control" placeholder="e.g. Ipan" required>
                </div>
                <div class="form-group" style="text-align: left;">
                    <label>Email Address</label>
                    <input type="email" id="signupEmail" class="form-control" placeholder="ipan@packetloss.com" pattern=".*@.*" title="Please include an '@' in the email address." required>
                </div>
                <div class="form-group" style="text-align: left;">
                    <label>Band Role / Instrument</label>
                    <input type="text" id="signupRole" class="form-control" placeholder="e.g. Bassist" required>
                </div>
                <div class="form-row">
                    <div class="form-group" style="text-align: left;">
                        <label>Password</label>
                        <input type="password" class="form-control" required>
                    </div>
                    <div class="form-group" style="text-align: left;">
                        <label>Confirm</label>
                        <input type="password" class="form-control" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">Create Account</button>
            </form>
            <p style="margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-secondary);">
                Already have an account? <span class="auth-link" onclick="toggleAuthView('login')">Sign In</span>
            </p>
            <div style="margin: 1.5rem 0; color: var(--text-secondary);">OR</div>
            <button class="btn google-btn" onclick="handleSignup(event)">
                <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/></svg>
                Sign up with Google
            </button>
        </div>
    </div>

    <div id="forgot-view" class="auth-view hidden">
        <div class="auth-card">
            <div class="logo-container" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18V5l12-2v13"></path>
                    <circle cx="6" cy="18" r="3"></circle>
                    <circle cx="18" cy="16" r="3"></circle>
                </svg>
                <h1 style="color: var(--accent); letter-spacing: 2px; margin: 0;">GigSpot</h1>
            </div>
            <p style="color: var(--text-secondary); margin-bottom: 2rem;">Reset Your Password</p>
            <form onsubmit="handleForgotPassword(event)">
                <div class="form-group" style="text-align: left;">
                    <label>Email Address</label>
                    <input type="email" id="forgotEmail" class="form-control" placeholder="Enter your email" pattern=".*@.*" title="Please include an '@' in the email address." required>
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">Send Reset Link</button>
            </form>
            <p style="margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-secondary);">
                Remember your password? <span class="auth-link" onclick="toggleAuthView('login')">Sign In</span>
            </p>
        </div>
    </div>

    <div id="app-layout" class="hidden">
        
        <aside class="sidebar">
            <div class="brand" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18V5l12-2v13"></path>
                    <circle cx="6" cy="18" r="3"></circle>
                    <circle cx="18" cy="16" r="3"></circle>
                </svg>
                GigSpot
            </div>
            <ul class="nav-links">
                <li><a onclick="switchTab('dashboard')" id="nav-dashboard" class="active">Dashboard Overview</a></li>
                <div class="sidebar-divider"></div>
                <li><a onclick="switchTab('profile')" id="nav-profile">My Profile</a></li>
                <li><a onclick="switchTab('gear')" id="nav-gear">Gear Inventory</a></li>
                <li><a onclick="switchTab('upcoming')" id="nav-upcoming">Upcoming Gigs</a></li>
                <li><a onclick="switchTab('past')" id="nav-past">Past Performances</a></li>
                <li><a onclick="switchTab('team')" id="nav-team">Band Roster</a></li>
                <div class="sidebar-divider"></div>
                <li><a onclick="switchTab('settings')" id="nav-settings">Settings & API</a></li>
                <li><a onclick="logout()" style="color: var(--danger); margin-top: 1rem;">Logout</a></li>
            </ul>
        </aside>

        <main class="main-content">
            <div class="top-navbar">
                <h2 id="page-title">Dashboard Overview</h2>
                <div class="role-simulator">
                    <span>Simulating Role: <strong id="currentRoleText" style="color: var(--accent);">Admin</strong></span>
                    <button class="btn btn-outline btn-sm" onclick="toggleRole()">Switch Role</button>
                </div>
            </div>

            <div class="content-body">

                <div id="dashboard-view">
                    <div class="dashboard-overview-grid">
                        <div style="display: flex; flex-direction: column; gap: 2rem;">
                            <div class="dash-widget">
                                <h3>Quick Profile</h3>
                                <div class="profile-summary">
                                    <img src="https://via.placeholder.com/60?text=U" id="dashAvatar" alt="Profile">
                                    <div>
                                        <div style="font-weight: bold; font-size: 1.1rem;" id="dashName">Ipan</div>
                                        <div style="color: var(--text-secondary); font-size: 0.9rem;" id="dashRole">Bassist / Admin</div>
                                    </div>
                                </div>
                            </div>

                            <div class="dash-widget">
                                <h3>Active Roster</h3>
                                <div class="roster-summary" id="dashRosterBadges">
                                    </div>
                                <div style="margin-top: 1rem; font-size: 0.85rem; color: var(--accent); cursor: pointer;" onclick="switchTab('team')">Manage Team →</div>
                            </div>
                        </div>

                        <div class="dash-widget">
                            <h3>Up Next</h3>
                            <div id="up-next-container"></div>
                        </div>
                    </div>
                </div>

                <div id="profile-view" class="hidden">
                    <div class="settings-container">
                        <div class="settings-card">
                            <h3>Edit Personal Details</h3>
                            <div class="profile-edit-header">
                                <img src="https://via.placeholder.com/100?text=U" id="profileAvatarPreview" class="profile-avatar-large" alt="Profile Picture">
                                <div>
                                    <label for="profilePicInput" class="btn btn-outline btn-sm">Upload Photo</label>
                                    <input type="file" id="profilePicInput" class="file-input-hidden" accept="image/png, image/jpeg" onchange="previewProfileImage(event)">
                                </div>
                            </div>

                            <form onsubmit="saveProfileDetails(event)">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Full Name</label>
                                        <input type="text" class="form-control" id="inputProfileName" value="Ipan (Muhammad Irfan)" required>
                                    </div>
                                    <div class="form-group">
                                        <label>Email Address</label>
                                        <input type="email" class="form-control" id="inputProfileEmail" value="ipan@packetloss.com" disabled>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Band Name</label>
                                        <input type="text" class="form-control" value="Packet Loss" disabled>
                                    </div>
                                    <div class="form-group">
                                        <label>Role / Instrument</label>
                                        <input type="text" class="form-control" id="inputProfileRole" value="Bassist / Band Admin" required>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary">Save Profile Changes</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div id="gear-view" class="hidden">
                    <div class="settings-container">
                        <div class="settings-card">
                            <h3>Band Equipment & Logistics List</h3>
                            <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Manage the master list of equipment your band owns or requires. This inventory will appear dynamically as checkboxes when you add or edit a gig's stage plot.</p>
                            
                            <div style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem;">
                                <input type="text" id="newGearInput" class="form-control" placeholder="e.g. In-Ear Monitors (IEMs), DI Box, etc." onkeydown="if(event.key === 'Enter') addGear()">
                                <button class="btn btn-primary" onclick="addGear()">Add Gear</button>
                            </div>

                            <ul class="team-list" id="gearListContainer">
                                </ul>
                        </div>
                    </div>
                </div>

                <div id="upcoming-view" class="hidden">
                    <div class="section-header">
                        <h3>Master Schedule</h3>
                        <button class="btn btn-primary" id="addGigBtn" onclick="openModal('gigModal')">+ Add New Gig</button>
                    </div>
                    <section class="gigs-grid" id="upcoming-gigs-container"></section>
                </div>

                <div id="past-view" class="hidden">
                    <div class="section-header">
                        <h3>Performance Archive</h3>
                    </div>
                    <section class="gigs-grid" id="past-gigs-container"></section>
                </div>

                <div id="team-view" class="hidden">
                    <div class="settings-container">
                        
                        <div class="settings-card" id="pendingInvitesCard" style="border: 1px solid var(--warning); display: none;">
                            <h3 style="color: var(--warning); border-bottom-color: var(--warning);">Pending Invitations</h3>
                            <ul class="team-list" id="pendingTeamList">
                                </ul>
                        </div>

                        <div class="settings-card">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
                                <h3 style="border: none; margin: 0; padding: 0;">Packet Loss Roster</h3>
                                <button class="btn btn-outline btn-sm" id="inviteBtn" onclick="openModal('inviteModal')">+ Invite Member</button>
                            </div>
                            <ul class="team-list" id="activeTeamList">
                                </ul>
                        </div>

                    </div>
                </div>

                <div id="settings-view" class="hidden">
                    <div class="settings-container">
                        <div class="settings-card">
                            <h3>Google Calendar API Integration</h3>
                            <p style="color: var(--text-secondary); margin-bottom: 1rem;">Your account is linked to Google Calendar. Logistics and schedules automatically sync.</p>
                            <div style="background-color: #000; padding: 1rem; border-radius: 6px; font-family: monospace; color: var(--success); margin-bottom: 1rem;">
                                Status: ACTIVE<br>
                                OAuth Token: ya29.a0AWY7CkmX...<br>
                                Last Sync: Today at 08:00 AM
                            </div>
                            <button class="btn btn-danger">Revoke API Access</button>
                            <button class="btn btn-outline" style="margin-left: 0.5rem;">Force Manual Sync</button>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <div id="gigModal" class="modal-overlay hidden">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalTitle">Add New Gig</h3>
                <button class="close-btn" onclick="closeModal('gigModal')">&times;</button>
            </div>
            
            <form id="gigForm" onsubmit="submitGig(event)">
                <input type="hidden" id="gigId">
                <h4 style="color: var(--accent); margin-bottom: 1rem;">1. Logistics</h4>
                <div class="form-group">
                    <label>Event / Gig Title</label>
                    <input type="text" id="gigTitle" class="form-control" required>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Venue Name</label>
                        <input type="text" id="gigVenue" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Event Date</label>
                        <input type="date" id="gigDate" class="form-control" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Call Time</label>
                        <input type="time" id="gigCallTime" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Performance Time</label>
                        <input type="time" id="gigStageTime" class="form-control" required>
                    </div>
                </div>

                <div class="section-divider"></div>
                <h4 style="color: var(--accent); margin-bottom: 1rem;">2. Dynamic Setlist Builder</h4>
                <div class="form-group">
                    <label>Type a song and press "Enter" or click "Add"</label>
                    <div style="display: flex; gap: 0.5rem; margin-bottom: 0.8rem;">
                        <input type="text" id="songInput" class="form-control" placeholder="e.g. Malam Pagi (Cover)" onkeydown="handleSongEnter(event)">
                        <button type="button" class="btn btn-outline" onclick="addSongToSetlist()">Add</button>
                    </div>
                    <div id="setlistTagsContainer" style="display: flex; flex-wrap: wrap; gap: 0.5rem; min-height: 40px; padding: 0.5rem; border: 1px dashed #444; border-radius: 6px;"></div>
                </div>

                <div class="section-divider"></div>
                <h4 style="color: var(--accent); margin-bottom: 1rem;">3. Stage Plot & Gear Checklist</h4>
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem;">Check the equipment required for this specific performance based on your master inventory.</p>
                <div class="form-group checkbox-grid" id="dynamicGearCheckboxes">
                    </div>

                <div style="margin-top: 2rem; display: flex; gap: 1rem;">
                    <button type="button" class="btn btn-outline" style="flex: 1;" onclick="closeModal('gigModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="flex: 2;">Save & Sync Calendar</button>
                </div>
            </form>
        </div>
    </div>

    <div id="inviteModal" class="modal-overlay hidden">
        <div class="modal-content" style="max-width: 500px;">
            <div class="modal-header">
                <h3>Invite Teammate</h3>
                <button class="close-btn" onclick="closeModal('inviteModal')">&times;</button>
            </div>
            
            <form onsubmit="sendInvite(event)">
                <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Send an email invitation. They will be added to the pending roster until they accept.</p>
                <div class="form-group">
                    <label>Teammate Name</label>
                    <input type="text" id="inviteName" class="form-control" placeholder="e.g. Adib" required>
                </div>
                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" id="inviteEmail" class="form-control" placeholder="adib@packetloss.com" pattern=".*@.*" title="Please include an '@' in the email address." required>
                </div>
                <div class="form-group">
                    <label>Band Role / Instrument</label>
                    <input type="text" id="inviteRole" class="form-control" placeholder="e.g. Keyboardist" required>
                </div>
                <div style="margin-top: 2rem; display: flex; gap: 1rem;">
                    <button type="button" class="btn btn-outline" style="flex: 1;" onclick="closeModal('inviteModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="flex: 2;">Send Invite</button>
                </div>
            </form>
        </div>
    </div>

    <div id="editMemberModal" class="modal-overlay hidden">
        <div class="modal-content" style="max-width: 500px;">
            <div class="modal-header">
                <h3>Edit Team Member</h3>
                <button class="close-btn" onclick="closeModal('editMemberModal')">&times;</button>
            </div>
            
            <form onsubmit="saveMemberEdit(event)">
                <input type="hidden" id="editMemberId">
                <div class="form-group">
                    <label>Teammate Name</label>
                    <input type="text" id="editMemberName" class="form-control" required>
                </div>
                <div class="form-group">
                    <label>Band Role / Instrument</label>
                    <input type="text" id="editMemberRole" class="form-control" required>
                </div>
                <div class="form-group">
                    <label>System Access Level</label>
                    <select id="editMemberAccess" class="form-control">
                        <option value="Read-Only">Read-Only</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>
                <div style="margin-top: 2rem; display: flex; gap: 1rem;">
                    <button type="button" class="btn btn-outline" style="flex: 1;" onclick="closeModal('editMemberModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="flex: 2;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script src="app.js?v=2"></script>
</body>
</html>

